// Electronic theme for Touying: slides decorated with printed circuit board
// (PCB) traces, generated by `pcb.typ`. The title, outline and focus slides
// draw their background as a circuit board; regular slides keep a plain page
// with a header (title and mini-slides navigation) and a footer.
// Colours come from a palette of `palettes.typ`.

#import "/touying.typ": *
#import "palettes.typ": *
#import "footer.typ": _footer
#import "header.typ": _header
#import "title.typ": _title
#import "pcb.typ": (
  focus-geometry, focus-slide-pcb, outline-slide-pcb, title-slide-pcb,
)

/// Default slide function for the presentation.
///
/// - title (string): The title of the slide, displayed in the header. Default is `auto`.
///
/// - align (alignment): The alignment of the slide content. Default is `auto`, which uses the `align` argument of `phd-theme`.
///
/// - config (dictionary): The configuration of the slide. You can use `config-xxx` to set the configuration of the slide. For several configurations, you can use `utils.merge-dicts` to merge them.
///
/// - repeat (int, string): The number of subslides. Default is `auto`, which means touying will automatically calculate the number of subslides.
///
///   The `repeat` argument is necessary when you use `#slide(repeat: 3, self => [ .. ])` style code to create a slide. The callback-style `uncover` and `only` cannot be detected by touying automatically.
///
/// - setting (function): The setting of the slide. You can use it to add some set/show rules for the slide.
///
/// - composer (function, array): The composer of the slide. You can use it to set the layout of the slide.
///
///   For example, `#slide(composer: (1fr, 2fr, 1fr))[A][B][C]` to split the slide into three parts. The first and the last parts will take 1/4 of the slide, and the second part will take 1/2 of the slide.
///
///   If you pass a non-function value like `(1fr, 2fr, 1fr)`, it will be assumed to be the first argument of the `cols` function.
///
///   The `cols` function is a simple wrapper of the `grid` function. It means you can use the `grid.cell(colspan: 2, ..)` to make the cell take 2 columns.
///
///   For example, `#slide(composer: 2)[A][B][#grid.cell(colspan: 2)[Footer]]` will make the `Footer` cell take 2 columns.
///
///   If you want to customize the composer, you can pass a function to the `composer` argument. The function should receive the contents of the slide and return the content of the slide, like `#slide(composer: grid.with(columns: 2))[A][B]`.
///
/// - bodies (array): The contents of the slide. You can call the `slide` function with syntax like `#slide[A][B][C]` to create a slide.
#let slide(
  title: auto,
  align: auto,
  config: (:),
  repeat: auto,
  setting: body => body,
  composer: auto,
  ..bodies,
) = touying-slide-wrapper(self => {
  if align != auto {
    self.store.align = align
  }
  let header(self) = _header(self, title)
  let footer(self) = _footer(self)

  let self = utils.merge-dicts(
    self,
    config-page(
      fill: self.colors.neutral-lightest,
      header: header,
      footer: footer,
    ),
  )
  let new-setting = body => {
    show: std.align.with(self.store.align)
    set text(fill: self.colors.neutral-darkest)
    show: setting
    pad(top: 1em, body)
  }
  touying-slide(
    self: self,
    config: config,
    repeat: repeat,
    setting: new-setting,
    composer: composer,
    ..bodies,
  )
})


/// Title slide for the presentation, with a circuit board in the bottom-right
/// corner (`title-slide-pcb`). You should update the information in the
/// `config-info` function. You can also pass the information directly to the
/// `title-slide` function.
///
/// The slide displays `title`, `author`, `date`, `supervisors`, `reviewers`
/// and `examiners` (a name or an array of names), and the row of logos given
/// by `logo-academic`, `logo-cifre` and `logo-anrt` (image paths, or none).
///
/// Example:
///
/// ```typst
/// #show: phd-theme.with(
///   config-info(
///     title: [Title],
///     author: [Author],
///     logo-academic: "/assets/ietr-logo.png",
///     supervisors: ("Supervisor A", "Supervisor B"),
///   ),
/// )
///
/// #title-slide()
/// ```
///
/// - config (dictionary): The configuration of the slide. You can use `config-xxx` to set the configuration of the slide. For several configurations, you can use `utils.merge-dicts` to merge them.
///
/// - extra (string, none): Currently unused.
#let title-slide(
  config: (:),
  extra: none,
  ..args,
) = touying-slide-wrapper(self => {
  self = utils.merge-dicts(
    self,
    config-common(freeze-slide-counter: true),
    config-page(
      fill: self.colors.neutral-lightest,
      background: place(
        bottom + right,
        title-slide-pcb(self),
      ),
    ),
    config,
  )
  let info = self.info + args.named()
  let body = _title(self, info)
  touying-slide(self: self, body)
})


/// Touying outline slide drawn as a circuit board (see `outline-slide-pcb`):
/// every section is a chip, and traces run out of its pins.
/// Sections are the level-1 headings of the document. The board fills the
/// whole band between header and footer, edge to edge.
///
/// `title`:      the slide title. Default is `[Outline]`.
/// `sections`:   override the headings with your own array of content.
/// `numbering`:  number format of the chips. Default is `"01"`.
/// `hl-current`: true to highlight the section the slide sits in
///               (its chip and traces take `primary`, the others fade).
/// `hl-all`:     true to draw every chip and its pins in `primary`.
/// `full-width`: false keeps the field inside the side margins.
/// `extend-top` / `extend-bottom`: grow the field past the body into the
///               margin, to close any gap the theme leaves under the header
///               or above the footer.
/// Any other named argument goes to `outline-slide-pcb` / `pcb-field`
/// (seed, traces, cascade, step, fade, ...).
#let outline-slide(
  config: (:),
  title: [Outline],
  sections: auto,
  numbering: "01",
  hl-current: false,
  hl-all: false,
  full-width: true,
  extend-top: 0pt,
  extend-bottom: 0pt,
  ..args,
) = slide(title: title, config: config, self => {
  // colors
  let accent = self.colors.at("primary", default: rgb("#1f6feb"))
  let ink = self.colors.at("neutral-darkest", default: rgb("#1c2128"))
  let paper = self.colors.at("neutral-lightest", default: white)

  let chip-stroke = if hl-all { accent.lighten(10%) } else { ink.lighten(20%) }
  let pin-color = if hl-all { accent.lighten(10%) } else { ink.lighten(60%) }

  // side margins of the page, so the field can bleed into them
  let margin = self.page.at("margin", default: 0pt)
  let side(k) = if type(margin) == dictionary {
    margin.at(k, default: margin.at("x", default: margin.at(
      "rest",
      default: 0pt,
    )))
  } else { margin }

  layout(size => context {
    let abs(v) = if type(v) == length { v.to-absolute() } else if (
      type(v) == ratio
    ) {
      v * page.width
    } else if type(v) == relative {
      v.ratio * page.width + v.length.to-absolute()
    } else { 0pt }

    let (ml, mr) = if full-width {
      (abs(side("left")), abs(side("right")))
    } else { (0pt, 0pt) }

    let et = abs(extend-top)
    let eb = abs(extend-bottom)

    let sel = heading.where(level: 1, outlined: true)

    let (bodies, current) = if sections == auto {
      let hs = query(sel)
      let before = query(sel.before(here()))
      let cur = if not hl-current or before.len() == 0 { none } else {
        hs.position(h => h.location() == before.last().location())
      }
      (hs.map(h => h.body), cur)
    } else { (sections, none) }

    // a slide body can report an unbounded height; fall back to 16:9 room
    let body-h = if size.height < 2000pt { size.height } else {
      size.width * 9 / 16
    }

    // full-size block: themes that centre the body would otherwise centre
    // a zero-height `place` and push the board halfway down the slide
    block(width: size.width, height: body-h, place(
      top + left,
      dx: -ml,
      dy: -et,
      outline-slide-pcb(
        bodies,
        current: current,
        width: size.width + ml + mr,
        height: body-h + et + eb,
        number-format: numbering,
        accent: accent,
        chip-fill: paper,
        chip-stroke: chip-stroke,
        text-color: ink,
        trace-color: ink.lighten(86%),
        pin-color: pin-color,
        ..args.named(),
      ),
    ))
  })
})


/// New section slide for the presentation: the section heading above a progress bar. You can update it by updating the `new-section-slide-fn` argument for `config-common` function.
///
/// Example: `config-common(new-section-slide-fn: new-section-slide.with(numbered: false))`
///
/// - config (dictionary): The configuration of the slide. You can use `config-xxx` to set the configuration of the slide. For several configurations, you can use `utils.merge-dicts` to merge them.
///
/// - level (int): The level of the heading.
///
/// - numbered (boolean): Indicates whether the heading is numbered.
///
/// - body (auto): The body of the section. It will be passed by touying automatically.
#let new-section-slide(
  config: (:),
  level: 1,
  numbered: true,
  body,
) = touying-slide-wrapper(self => {
  let slide-body = {
    set std.align(horizon)
    show: pad.with(20%)
    set text(size: 1.5em)
    stack(
      dir: ttb,
      spacing: 1em,
      text(self.colors.neutral-darkest, utils.display-current-heading(
        level: level,
        numbered: numbered,
        style: auto,
      )),
      block(
        height: 2pt,
        width: 100%,
        spacing: 0pt,
        components.progress-bar(
          height: 2pt,
          self.colors.primary,
          self.colors.primary-light,
        ),
      ),
    )
    text(self.colors.neutral-dark, body)
  }
  self = utils.merge-dicts(
    self,
    config-page(fill: self.colors.neutral-lightest),
  )
  touying-slide(self: self, config: config, slide-body)
})


/// Focus slide: the body sits in a centred rectangle on a dark circuit board
/// (`focus-slide-pcb`), with traces leaving the rectangle edges. The traces,
/// the rectangle and the text are all drawn in the page background, so they
/// stay aligned whatever the theme does with the header and the body area.
///
/// - config (dictionary): The configuration of the slide. You can use `config-xxx` to set the configuration of the slide. For several configurations, you can use `utils.merge-dicts` to merge them.
///
/// - align (alignment): The alignment of the text in the rectangle. Default is `horizon + center`.
#let focus-slide(
  config: (:),
  align: horizon + center,
  body,
) = touying-slide-wrapper(self => {
  let frame = self.colors.neutral-dark
  let ink = self.colors.neutral-lightest
  let styled = text(size: 1em, fill: ink, body)
  self = utils.merge-dicts(
    self,
    config-common(freeze-slide-counter: true),
    config-page(fill: frame, margin: 2em, background: context {
      // some themes anchor the background away from the page origin, so
      // measure where it really sits and place everything relative to that
      let p = here().position()
      let w = page.width
      let h = page.height
      let geo = focus-geometry(styled, w, h)
      place(dx: -p.x, dy: -p.y, top + left, block(width: w, height: h, {
        place(top + left, focus-slide-pcb(
          self,
          width: w,
          height: h,
          rect: geo.grid,
        ))
        place(top + left, dx: geo.x, dy: geo.y, block(
          width: geo.w,
          height: geo.h,
          {
            rect(
              width: 100%,
              height: 100%,
              radius: 1.5pt,
              fill: frame,
              stroke: 1pt + ink,
            )
            place(top + left, block(width: geo.w, height: geo.h, std.align(
              align,
              pad(x: 1.4em, y: 1em, styled),
            )))
          },
        ))
      }))
    }),
  )
  set text(fill: ink, size: 1.5em)
  // the visible text lives in the background; the body only keeps the slide
  touying-slide(self: self, config: config, hide(styled))
})


/// Create a slide where the provided content blocks are displayed in a grid and coloured in a checkerboard pattern without further decoration. You can configure the grid using the rows and `columns` keyword arguments (both default to none). It is determined in the following way:
///
/// - If `columns` is an integer, create that many columns of width `1fr`.
/// - If `columns` is `none`, create as many columns of width `1fr` as there are content blocks.
/// - Otherwise assume that `columns` is an array of widths already, use that.
/// - If `rows` is an integer, create that many rows of height `1fr`.
/// - If `rows` is `none`, create that many rows of height `1fr` as are needed given the number of content blocks and columns.
/// - Otherwise assume that `rows` is an array of heights already, use that.
/// - Check that there are enough rows and columns to fit in all the content blocks.
///
/// That means that `#matrix-slide[...][...]` stacks horizontally and `#matrix-slide(columns: 1)[...][...]` stacks vertically.
///
/// - config (dictionary): is the configuration of the slide. Use `config-xxx` to set individual configurations for the slide. To apply multiple configurations, use `utils.merge-dicts` to combine them.
#let matrix-slide(
  config: (:),
  columns: none,
  rows: none,
  ..bodies,
) = touying-slide-wrapper(self => {
  self = utils.merge-dicts(
    self,
    config-common(freeze-slide-counter: true),
    config-page(margin: 0em),
  )
  touying-slide(
    self: self,
    config: config,
    composer: components.checkerboard.with(
      secondary: self.colors.secondary-lightest,
      columns: columns,
      rows: rows,
    ),
    ..bodies,
  )
})


/// Touying electronic theme, for a PhD defense.
///
/// Example:
///
/// ```typst
/// #show: phd-theme.with(
///   aspect-ratio: "16-9",
///   header-with-mini-slides: true,
///   palette: palette-colors("indigo"),
///   config-info(title: [Title], author: [Author]),
/// )
/// ```
///
/// - aspect-ratio (string): The aspect ratio of the slides. Default is `16-9`.
///
/// - align (alignment): The alignment of the content. Default is `start`.
///
/// - header-with-mini-slides (boolean): Whether to display the mini-slides navigation in the header. Default is `false`.
///
/// - palette (dictionary): The colours of the theme, a palette of `palettes.typ` given by `palette-colors`. Default is `palette-colors("mono-red")`.
///
/// - mini-slides (dictionary): The settings of the mini-slides navigation (`height`, `x`, `fill`, `alpha`, `display-section`, `display-subsection`, `linebreaks`, `short-heading`, `inline`). `height` and `x` also set the top and side margins of the page. Missing keys take their default value.
///
/// - header (content, function): The header of the slide. Default is `self => utils.display-current-heading(setting: utils.fit-to-width.with(grow: false, 100%), depth: self.slide-level)`.
///
/// - header-right (content, function): The right part of the header, stored but not displayed by `header.typ`. Default is `none`.
///
/// - footer (content, function): The left part of the footer. Default is `none`.
///
/// - footer-right (content, function): The right part of the footer. Default is `context utils.slide-counter.display() + " / " + utils.last-slide-number`.
///
/// - footer-progress (boolean): Whether to show the progress bar in the footer. Default is `true`.
#let phd-theme(
  aspect-ratio: "16-9",
  align: start,
  header-with-mini-slides: false,
  palette: palette-colors("mono-red"),
  mini-slides: (
    height: 4em,
    x: 2em,
    display-section: false,
    display-subsection: true,
    linebreaks: true,
    short-heading: true,
  ),
  header: self => utils.display-current-heading(
    setting: utils.fit-to-width.with(grow: false, 100%),
    depth: self.slide-level,
  ),
  header-right: none,
  footer: none,
  footer-right: context utils.slide-counter.display()
    + " / "
    + utils.last-slide-number,
  footer-progress: true,
  ..args,
  body,
) = {
  set text(size: 20pt)

  show footnote.entry: set text(size: 0.7em)
  set footnote.entry(
    indent: 0.2em,
    separator: block(width: 100%, {
      place(dx: -2% + 2pt, dy: 0%, line(length: 69% + 0pt, stroke: (
        paint: palette.primary,
        thickness: 0.3pt,
        cap: "round",
      )))
      place(dx: -2% - 1.1pt, dy: 0% - 1.45pt, circle(
        radius: 1.5pt,
        stroke: .3pt + palette.primary,
        fill: none,
      ))
    }),
  )

  mini-slides = utils.merge-dicts(
    (
      height: 4em,
      x: 2em,
      display-section: false,
      display-subsection: true,
      linebreaks: true,
      short-heading: true,
    ),
    mini-slides,
  )

  show: touying-slides.with(
    config-page(
      ..utils.page-args-from-aspect-ratio(aspect-ratio),
      header-ascent: 30%,
      footer-descent: 30%,
      margin: (top: mini-slides.height, bottom: 2em, x: mini-slides.x),
    ),
    config-common(
      slide-fn: slide,
      new-section-slide-fn: new-section-slide,
    ),
    config-methods(
      alert: utils.alert-with-primary-color,
    ),
    config-colors(..palette),
    // save the variables for later use
    config-store(
      align: align,
      header-with-mini-slides: header-with-mini-slides,
      mini-slides: mini-slides,
      header: header,
      header-right: header-right,
      footer: footer,
      footer-right: footer-right,
      footer-progress: footer-progress,
    ),
    config-info(
      title: [PhD title],
      author: [Author],
      logo-academic: none,
      logo-cifre: none,
      logo-anrt: none,
      date: str(datetime.today().year()),
      supervisors: none,
      reviewers: none,
      examiners: none,
    ),
    ..args,
  )

  body
}
